# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- Virtual environments ------------------------------------------------------
.venv/
venv/
env/
ENV/

# --- Tooling caches -------------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# --- Datasets -------------------------------------------------------------------
# Source corpora are large and externally sourced; they are reproduced from the
# dataset fingerprint rather than committed.
data/raw/*
data/cache/*
data/corpus/*
data/processed/*
!data/raw/.gitkeep
!data/cache/.gitkeep
!data/corpus/.gitkeep
!data/processed/.gitkeep

# --- Run artefacts --------------------------------------------------------------
# The output package is a build product: it is regenerated by a pipeline run and
# is byte-reproducible from the config fingerprint plus the source datasets.
outputs/logs/
outputs/preprocessed_dataset/dataset/
outputs/preprocessed_dataset/dataloaders/*.pt
outputs/preprocessed_dataset/metadata/*.parquet
outputs/preprocessed_dataset/reports/*.pdf
*.jsonl

# --- Editors and OS ---------------------------------------------------------------
.vscode/
.idea/
*.swp
Thumbs.db
Desktop.ini
.DS_Store
outputs/preprocessed_dataset/dataset.zip 
